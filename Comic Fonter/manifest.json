{
    "name": "Comic Fonter",
    "version": "0.0.4",
    "description": "ウェブページのフォントを Comic Sans 風にします",
    "icons": { "128": "comic.png" },
    "permissions": ["fontSettings"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [{
        "css": ["comic.css"],
        "js": ["fonts.js"],
        "run_at": "document_start",
        "matches": ["<all_urls>"]
    }],
    "web_accessible_resources": [{
        "resources": ["fonts/*.woff2"],
        "matches": ["<all_urls>"]
    }],
    "manifest_version": 3
}